# ── Local dev (SQLite) ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# SQLite file path (omit to use data/sfhealth.db)
# DB_PATH=./data/sfhealth.db

# ── Production (Postgres) ───────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/sfhealth

# ── Optional: restrict CORS to your domain ─────────────────────────
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── CLI audit credentials (optional, for npm run audit:cli) ─────────
# SF_LOGIN_URL=login.salesforce.com
# SF_USERNAME=admin@myorg.com
# SF_PASSWORD=passwordPlusSecurityToken
# SF_CLIENT_ID=connectedAppClientId
# SF_CLIENT_SECRET=connectedAppClientSecret
