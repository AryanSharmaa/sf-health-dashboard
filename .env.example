# ── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://sf-health-dashboard.onrender.com

# ── Salesforce Connected App (REQUIRED for OAuth) ─────────────────────
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# ── Database ──────────────────────────────────────────────────────────
# Leave blank for SQLite locally
# DATABASE_URL=postgresql://user:password@host:5432/sfhealth

# ── Optional ──────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://yourdomain.com
